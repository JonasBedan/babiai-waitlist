# Zkopírujte do .env a doplňte. Do prohlížeče patří JEN anonymní (publishable) klíč.
# Service role / secret klíč sem nikdy nedávejte.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Doména webu, jak je zadaná v Plausible (např. aibezobav.cz). Prázdné = nic se neměří.
VITE_PLAUSIBLE_DOMAIN=
# Veřejná adresa webu bez lomítka na konci, kvůli náhledovému obrázku pro sdílení.
VITE_SITE_URL=https://example.cz
